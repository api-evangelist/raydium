              }
            ]
          },
          "docs": "Look up mints by IDs"
        },
        {
          "info": {
            "name": "Get spot prices for mints",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-v3.raydium.io/mint/price",
            "params": [
              {
                "name": "mints",
                "value": "",
                "type": "query",
                "description": "Comma-separated mint addresses."
              }
            ]
          },
          "docs": "Get spot prices for mints"
